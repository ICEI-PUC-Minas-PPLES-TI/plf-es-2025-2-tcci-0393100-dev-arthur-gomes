{
  "name": "swagger-to-sdk",
  "displayName": "Swagger to SDK",
  "description": "Generate typed TypeScript SDK files from OpenAPI specs",
  "version": "0.0.6",
  "publisher": "SitaGomes",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ICEI-PUC-Minas-PPLES-TI/plf-es-2025-2-tcci-0393100-dev-arthur-gomes"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:plf-es-view",
    "onCommand:plf-es-extension.importOpenAPI",
    "onCommand:plf-es-extension.generateSDK",
    "onCommand:plf-es-extension.changeToExtensionTab"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "plf-es-sidebar",
          "title": "Swagger to SDK",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "plf-es-sidebar": [
        {
          "id": "plf-es-view",
          "name": "Swagger to SDK",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "plf-es-extension.importOpenAPI",
        "title": "Swagger to SDK: Import OpenAPI"
      },
      {
        "command": "plf-es-extension.generateSDK",
        "title": "Swagger to SDK: Generate SDK"
      },
      {
        "command": "plf-es-extension.changeToExtensionTab",
        "title": "Swagger to SDK: Open Extension Tab"
      }
    ],
    "configuration": {
      "title": "Swagger to SDK",
      "properties": {
        "plfEs.importPath": {
          "type": "string",
          "default": "",
          "description": "OpenAPI source file path or URL used by Swagger to SDK."
        },
        "plfEs.outputPath": {
          "type": "string",
          "default": "generated-sdk",
          "description": "Output directory for generated SDK files."
        },
        "plfEs.baseURL": {
          "type": "string",
          "default": "",
          "description": "Optional base URL used to prefix generated client requests."
        },
        "plfEs.adapter": {
          "type": "string",
          "enum": [
            "fetch",
            "axios",
            "react-query"
          ],
          "default": "fetch",
          "description": "HTTP adapter used by generated SDK clients."
        }
      }
    }
  },
  "scripts": {
    "publish-patch": "./scripts/release.sh --bump patch ",
    "vscode:prepublish": "npm run compile && npm run bundle",
    "package": "npm install && npm run compile && npm run bundle && vsce package",
    "publish": "vsce publish",
    "bundle": "esbuild ./src/extension.ts --bundle --platform=node --format=cjs --outfile=out/extension.js --external:vscode --sourcemap",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vitest run",
    "test:types": "vitest run --typecheck",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vitest/coverage-v8": "4.1.2",
    "esbuild": "^0.27.7",
    "typescript": "^5.3.0",
    "vitest": "4.1.2"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
